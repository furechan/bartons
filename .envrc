# direnv config file

sops_import pypi

# Native Rust tests, examples, and benchmarks embed the uv-managed Python.
# PyO3 needs its interpreter at link time and its shared library at run time.
if [[ -x "$PWD/.venv/bin/python" ]]; then
    export PYO3_PYTHON="$PWD/.venv/bin/python"
    bartons_python_libdir="$("$PYO3_PYTHON" -c 'import sysconfig; print(sysconfig.get_config_var("LIBDIR"))')"
    export LD_LIBRARY_PATH="$bartons_python_libdir${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    unset bartons_python_libdir
fi
